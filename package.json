{
  "name": "code-companion",
  "version": "0.1.0",
  "description": "A developer's work journal from your git repositories: today's commits in the daily note, a weekly report, and a TODO list that opens in your editor.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "summary:live": "esbuild scripts/summary-live.ts --bundle --platform=node --format=cjs --outfile=.e2e/summary-live.cjs --log-level=warning && node .e2e/summary-live.cjs"
  },
  "keywords": [
    "obsidian",
    "git",
    "developer",
    "journal",
    "daily-notes",
    "todo",
    "ollama"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
